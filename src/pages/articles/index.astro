---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import ArticleSearchBar from '../../components/ArticleSearchBar.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style is:inline>
			main {
				width: 66vw !important;
			}
			
			.post-list {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.post-item {
				width: calc(50% - 1rem);
			}
			.post-item * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			.post-item:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			.post-item:first-child img {
				width: 80%;
			}
			.post-item:first-child .title {
				font-size: 2.369rem;
			}
			.post-item img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			.post-item a {
				display: block;
			}

			.post-item .title {
				margin: 0;
				color: hsl(from var(--accent) h s calc(l * 0.5));
				line-height: 1;
			}
			.post-item .date {
				margin: 0;
				color: hsl(from var(--blue) h s calc(l * 0.5));
			}
			.post-item a:hover h4 {
				/* color: var(--accent); */
				color: hsl(from var(--accent) h s calc(l * 1.2));
			}
			
			.post-item a:hover .date {
				color: hsl(from var(--blue) h s calc(l * 1.2));
			}

			.post-list a:hover img {
				box-shadow: var(--box-shadow);
				transform: translate(0, -0.5em);
			}

			.post-list a:checked img {
				transform: translate(0, +0.5em);
			}

			.input-field {
				width: 100%;
				height: 3em;
				background-color: var(--header-color);
				box-shadow: var(--box-shadow-lighter);
				box-sizing: border-box;
				border: none;
				border-radius: 4px;
				color: var(--text-color);
				transition: 0ms;
				padding-left: 2em;
			}

			.input-field:focus {
				border: 2px solid var(--accent);
				outline: none;
			}

			.input-field::placeholder {
				margin-left: 50%;
			}

			.clear-button {
				position: absolute;
				color: var(--accent);
				height: 2em;
				width: 2em;
				top: 5%;
				transform: translate(-2.2em, 0);
				backdrop-filter: blur(2px);
				background-color: var(--header-color);
				font-size: 1em;
				border: unset;
				cursor: pointer;
			}

			.search-bar {
				position: relative;
				padding-bottom: 4em;
			}
			
			@media (max-width: 720px) {
				.post-list {
					gap: 0.5em;
				}
				.post-item {
					width: 100%;
					text-align: center;
				}
				.post-item:first-child {
					margin-bottom: 0;
				}
				.post-item:first-child .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<ArticleSearchBar />
		</main>
		<Footer />
	</body>
</html>
